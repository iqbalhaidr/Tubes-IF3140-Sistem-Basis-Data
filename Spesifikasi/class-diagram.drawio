&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; class Rows~T~ {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +data: vector~T~&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +rows_count: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +column_names: vector~string~&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +Rows()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +Rows(rows: vector~T~)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; class ExecutionResult {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +transaction_id: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +timestamp: time_t&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +message: string&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +query: string&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +data: Rows~Row~&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +affected_rows: int&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +success: bool&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; +ExecutionResult()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; %% Relationships sesuai diagram&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Operation &amp;lt;.. FailureRecoveryManager : uses&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FailureRecoveryManager *-- LogEntry : contains&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; RecoverCriteria ..&amp;gt; FailureRecoveryManager : uses&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; FailureRecoveryManager *-- CheckpointInfo : contains&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ExecutionResult ..&amp;gt; FailureRecoveryManager : uses&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp